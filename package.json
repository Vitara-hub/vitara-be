{
  "name": "vitara-be",
  "version": "0.1.0",
  "description": "Vitara health tracking backend — capstone project",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun run tsc -p tsconfig.build.json",
    "start": "bun run dist/index.js",
    "lint": "bun run eslint . --ext .ts",
    "lint:fix": "bun run eslint . --ext .ts --fix",
    "test": "bun test",
    "sb:start": "supabase start",
    "sb:stop": "supabase stop",
    "sb:status": "supabase status",
    "sb:db:reset": "supabase db reset",
    "sb:db:push": "supabase db push",
    "prepare": "husky"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "2.49.8",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "express": "4.22.1",
    "helmet": "8.1.0",
    "multer": "2.1.1",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.18",
    "@types/express": "5.0.2",
    "@types/multer": "1.4.12",
    "@types/node": "22.15.21",
    "@types/swagger-ui-express": "4.1.7",
    "bun-types": "1.3.13",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "supabase": "^2.98.2",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.59.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
